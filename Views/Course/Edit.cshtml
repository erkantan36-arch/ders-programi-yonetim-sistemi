@model ders_programi_yonetim_sistemi.Models.Course
@{ ViewData["Title"] = "Ders Düzenle"; }

<h2>Ders Düzenle</h2>
<form asp-action="Edit" method="post" class="card card-body">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Credit" class="form-label"></label><input asp-for="Credit" class="form-control" /><span asp-validation-for="Credit" class="text-danger"></span></div>
    <button class="btn btn-primary" type="submit">Güncelle</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
