@model IEnumerable<ders_programi_yonetim_sistemi.Models.Course>
@{
    ViewData["Title"] = "Dersler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Dersler</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Ders</a>
    }
</div>

<table class="table table-striped">
    <thead><tr><th>Kod</th><th>Ders</th><th>Kredi</th><th>İşlem</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Code</td>
            <td><a asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td>
            <td>@item.Credit</td>
            <td>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
