@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="text-center">
    <h1 class="display-6">Ders Programı Yönetim Sistemi</h1>
    <p>Haftalık programı görüntüleyin, dersleri yönetin, çakışmaları engelleyin.</p>
</div>

<div class="row g-3">
    <div class="col-md-4"><div class="card"><div class="card-body"><h5>Ders Sayısı</h5><p class="fs-4">@ViewBag.CourseCount</p></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><h5>Hoca Sayısı</h5><p class="fs-4">@ViewBag.InstructorCount</p></div></div></div>
    <div class="col-md-4"><div class="card"><div class="card-body"><h5>Program Kaydı</h5><p class="fs-4">@ViewBag.ScheduleCount</p></div></div></div>
</div>
