@model ders_programi_yonetim_sistemi.Models.Schedule

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post">
    @Html.AntiForgeryToken()
    @if (Model.Id != 0)
    {
        <input type="hidden" asp-for="Id" />
    }
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row g-3">
        <div class="col-md-4"><label asp-for="DayId" class="form-label"></label><select asp-for="DayId" asp-items="ViewBag.DayId" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="TimeSlotId" class="form-label"></label><select asp-for="TimeSlotId" asp-items="ViewBag.TimeSlotId" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="ClassModelId" class="form-label"></label><select asp-for="ClassModelId" asp-items="ViewBag.ClassModelId" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="ClassroomId" class="form-label"></label><select asp-for="ClassroomId" asp-items="ViewBag.ClassroomId" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="CourseId" class="form-label"></label><select asp-for="CourseId" asp-items="ViewBag.CourseId" class="form-select"></select></div>
        <div class="col-md-4"><label asp-for="InstructorId" class="form-label"></label><select asp-for="InstructorId" asp-items="ViewBag.InstructorId" class="form-select"></select></div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Kaydet</button>
        <a asp-action="Index" class="btn btn-secondary">Geri</a>
    </div>
</form>
