@model IEnumerable<ders_programi_yonetim_sistemi.Models.Schedule>
@using ders_programi_yonetim_sistemi.Models
@{
    ViewData["Title"] = "Ders Programı";
    var days = (List<Day>)ViewBag.Days;
    var slots = (List<TimeSlot>)ViewBag.TimeSlots;
    // Build lookup: (dayId, slotId) -> list of schedules
    var lookup = Model
        .GroupBy(s => (s.DayId, s.TimeSlotId))
        .ToDictionary(g => g.Key, g => g.ToList());
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ders Programı</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Ders Ekle</a>
    }
</div>

<div class="table-responsive">
    <table class="table table-bordered text-center align-middle" style="min-width:700px">
        <thead class="table-dark">
            <tr>
                <th style="width:130px">Saat</th>
                @foreach (var day in days)
                {
                    <th>@day.Name</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var slot in slots)
        {
            <tr>
                <td class="fw-semibold bg-light">@slot.DisplayName</td>
                @foreach (var day in days)
                {
                    <td class="p-1">
                    @if (lookup.TryGetValue((day.Id, slot.Id), out var cells) && cells.Count > 0)
                    {
                        foreach (var item in cells)
                        {
                            <div class="card mb-1 border-0 shadow-sm" style="font-size:.82rem;background:#e8f4fd">
                                <div class="card-body p-1">
                                    <div class="fw-bold">@item.Course?.Name</div>
                                    <div class="text-muted">@item.ClassModel?.Name — @item.Classroom?.Name</div>
                                    <div>@item.Instructor?.FullName</div>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
                                    {
                                        <div class="mt-1">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-xs btn-outline-primary py-0 px-1" style="font-size:.75rem">Düzenle</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-xs btn-outline-danger py-0 px-1" style="font-size:.75rem">Sil</a>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <span class="text-muted" style="font-size:.8rem">—</span>
                    }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
