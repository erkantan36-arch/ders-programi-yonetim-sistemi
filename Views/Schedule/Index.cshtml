@model IEnumerable<ders_programi_yonetim_sistemi.Models.Schedule>
@{
    ViewData["Title"] = "Haftalık Ders Programı";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Haftalık Takvim</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Program Kaydı</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3"><select class="form-select" name="classId" asp-items="ViewBag.Classes"><option value="">Tüm Sınıflar</option></select></div>
    <div class="col-md-3"><select class="form-select" name="instructorId" asp-items="ViewBag.Instructors"><option value="">Tüm Hocalar</option></select></div>
    <div class="col-md-3"><select class="form-select" name="classroomId" asp-items="ViewBag.Classrooms"><option value="">Tüm Derslikler</option></select></div>
    <div class="col-md-3 d-grid"><button type="submit" class="btn btn-outline-secondary">Filtrele</button></div>
</form>

<div class="table-responsive">
    <table class="table table-bordered schedule-table">
        <thead class="table-light">
        <tr><th>Gün</th><th>Saat</th><th>Derslik</th><th>Sınıf</th><th>Ders</th><th>Hoca</th><th>İşlem</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Day.Name</td>
                <td>@item.TimeSlot.Label</td>
                <td>@item.Classroom.Name</td>
                <td>@item.ClassModel.Name</td>
                <td>@item.Course.Name</td>
                <td>@item.Instructor.FullName</td>
                <td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Instructor"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
