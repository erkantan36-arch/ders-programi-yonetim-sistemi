@model ders_programi_yonetim_sistemi.ViewModels.ScheduleFormViewModel
@{
    ViewData["Title"] = "Ders Programı Düzenle";
}

<h2>Ders Programı Düzenle</h2>
<form asp-action="Edit" method="post" class="card card-body">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="DayId" class="form-label"></label><select asp-for="DayId" asp-items="ViewBag.Days" class="form-select"></select><span asp-validation-for="DayId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="TimeSlotId" class="form-label"></label><select asp-for="TimeSlotId" asp-items="ViewBag.TimeSlots" class="form-select"></select><span asp-validation-for="TimeSlotId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="ClassroomId" class="form-label"></label><select asp-for="ClassroomId" asp-items="ViewBag.Classrooms" class="form-select"></select><span asp-validation-for="ClassroomId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="ClassModelId" class="form-label"></label><select asp-for="ClassModelId" asp-items="ViewBag.Classes" class="form-select"></select><span asp-validation-for="ClassModelId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="CourseId" class="form-label"></label><select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select"></select><span asp-validation-for="CourseId" class="text-danger"></span></div>
        <div class="col-md-4"><label asp-for="InstructorId" class="form-label"></label><select asp-for="InstructorId" asp-items="ViewBag.Instructors" class="form-select"></select><span asp-validation-for="InstructorId" class="text-danger"></span></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea><span asp-validation-for="Notes" class="text-danger"></span></div>
    </div>
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a asp-action="Index" class="btn btn-secondary">İptal</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
