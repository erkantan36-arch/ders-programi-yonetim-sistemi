@model ders_programi_yonetim_sistemi.Models.Classroom
@{
    ViewData["Title"] = "Derslik Sil";
}

<h2>Derslik Sil</h2>

<div class="alert alert-warning" role="alert">
    <strong>@Model.Name</strong> dersliğini silmek istediğinizden emin misiniz?
</div>

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<dl class="row" style="max-width:400px">
    <dt class="col-sm-4">Derslik Adı</dt>
    <dd class="col-sm-8">@Model.Name</dd>
</dl>

<form asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sil</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>
