@model IEnumerable<ders_programi_yonetim_sistemi.Models.Classroom>
@{
    ViewData["Title"] = "Derslikler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Derslikler</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Derslik</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Derslik Adı</th>
            <th>Program Sayısı</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Schedules.Count</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Sil</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">← Admin Paneline Dön</a>
